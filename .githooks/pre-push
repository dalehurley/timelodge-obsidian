#!/bin/sh
set -eu
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        '(delete)') continue ;;
    esac
    git archive --format=tar --output="$snapshot/source.tar" "$local_sha"
    mkdir "$snapshot/source"
    tar -xf "$snapshot/source.tar" -C "$snapshot/source"
    (cd "$snapshot/source" && npm ci --no-audit --no-fund && npm run check) </dev/null
    rm -rf "$snapshot/source"
done
